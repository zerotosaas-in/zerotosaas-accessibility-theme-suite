    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zerotosaas.resetRestTimer",
          "when": "true"
        },
        {
          "command": "zerotosaas.openSettings",
          "when": "true"
        },
        {
          "command": "zerotosaas.openGuidelines",
          "when": "true"
        },
        {
          "command": "zerotosaas.showStatusHub",
          "when": "true"
        },
        {
          "command": "zerotosaas.applyReadingComfort",
          "when": "true"
        },
        {
          "command": "zerotosaas.resetReadingComfort",
          "when": "true"
        },
        {
          "command": "zerotosaas.toggleFocusMode",
          "when": "true"
        },
        {
          "command": "zerotosaas.toggleFocusTimer",
          "when": "true"
        }
      ]
    },
    "configurationDefaults": {
      "[markdown]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
          "comments": "off",
          "strings": "off",
          "other": "off"
        },
        "editor.renderWhitespace": "selection"
      },
      "[plaintext]": {
        "editor.wordWrap": "on"
      },
      "[sql]": {
        "editor.suggest.insertMode": "replace"
      },
      "[json]": {
        "editor.quickSuggestions": {
          "strings": true
        }
      },
      "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      }
    }
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "node scripts/generate-themes.js && node scripts/update-ide-configs.js && node scripts/generate-gallery.js && node scripts/export-tokens.js",
    "vscode:prepublish": "pnpm run build && pnpm run clean:vsix",
    "clean:vsix": "node scripts/clean-vsix.js",
    "update-ide-configs": "node scripts/update-ide-configs.js",
    "validate": "node scripts/validate-contrast.js",
    "gallery": "node scripts/generate-gallery.js",
    "tokens": "node scripts/export-tokens.js",
    "package": "vsce package --no-git-tag-version",
    "publish:ovsx": "ovsx publish",
    "publish:vsce": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^0.10.2"
  }
}
