      {
        "label": "ZeroToSaaS Terracotta Night (Orange)",
        "uiTheme": "vs-dark",
        "path": "./themes/zerotosaas-orange-night.json"
      }
    ],
    "configuration": {
      "title": "ZeroToSaaS Theme Suite",
      "properties": {
        "zerotosaas.errorLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Print compilation diagnostics and linter warnings inline at the end of broken code lines (Error Lens)."
        },
        "zerotosaas.errorLens.showEntireLineBackground": {
          "type": "boolean",
          "default": false,
          "description": "Highlight the entire line background in subtle Panic/Warning alert tint when an error occurs."
        },
        "zerotosaas.errorLens.showSeverityBadge": {
          "type": "boolean",
          "default": true,
          "description": "Display semantic severity badges ([Error], [Warning], [Info]) in inline diagnostics."
        },
        "zerotosaas.errorLens.showGitBlame": {
          "type": "boolean",
          "default": true,
          "description": "Inject instant line-by-line Git authorship history (Git Blame: author, time, commit) on Error Lens lines."
        },
        "zerotosaas.indentShading.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable alternating odd-sequence visible indent column background shading."
        },
        "zerotosaas.statusBadges.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic Safe, Caution, Warning, and Panic background status badges on code tokens."
        },
        "zerotosaas.statusBadges.detectSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Detect high-entropy secrets and provider tokens (AWS keys, GitHub/Slack PATs, JWTs, private key headers, Stripe keys, Google Cloud keys, Bearer tokens, database URIs) and flag them as Panic. Also scans .env files for secret keys and values."
        },
        "zerotosaas.statusBadges.detectHardcodedStrings": {
          "type": "boolean",
          "default": true,
          "description": "Detect non-secret hardcoded quoted strings in source code and flag them as Warning. String collection still runs internally for regex-literal exclusion even when disabled."
        },
        "zerotosaas.statusBadges.detectTypes": {
          "type": "boolean",
          "default": true,
          "description": "Detect type definitions (interfaces, types, classes, enums, structs), function parameters, and Markdown inline code blocks, flagging them as Safe or Caution."
        },
        "zerotosaas.statusBadges.detectLogSeverity": {
          "type": "boolean",
          "default": true,
          "description": "Detect log severity keywords (FATAL, ERROR, WARN, INFO, DEBUG, etc.) in .log files and flag them with the corresponding semantic status (Panic, Warning, Safe, Caution)."
        },
        "zerotosaas.statusBadges.detectConfigFiles": {
          "type": "boolean",
          "default": true,
          "description": "Detect sensitive configuration keys (SECRET, TOKEN, KEY, PASSWORD, etc.) in TOML, YAML, JSON, and INI files and flag them as Panic."
        },
        "zerotosaas.maxFileSizeKB": {
          "type": "number",
          "default": 500,
          "description": "Maximum file size in Kilobytes (KB) for full-document semantic status badge regex analysis."
        },
        "zerotosaas.restReminder.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the 20-20-20 Ocular Rest Assistant and blink reminder in the status bar."
        },
        "zerotosaas.restReminder.intervalMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Minutes between 20-20-20 ocular rest reminders."
        },
        "zerotosaas.restReminder.breakDurationSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "description": "Duration in seconds of each 20-20-20 eye break."
        },
        "zerotosaas.wellness.darkAdvisory.suppressed": {
          "type": "boolean",
          "default": false,
          "description": "Silence dark-theme eye-health advisories permanently (both the night-theme QuickPick notice and the external dark-activation warning). Re-enable any time from Settings. The full medical rationale remains available via the 'ZeroToSaaS: Open Eye-Health Guidelines' command."
        }
      }
    },
    "commands": [
      {
        "command": "zerotosaas.resetRestTimer",
        "category": "ZeroToSaaS",
        "title": "Reset 20-20-20 Rest Timer"
      },
      {
        "command": "zerotosaas.openSettings",
        "category": "ZeroToSaaS",
        "title": "Open ZeroToSaaS Settings"
      },
      {
        "command": "zerotosaas.openGuidelines",
        "category": "ZeroToSaaS",
        "title": "Open Eye-Health Guidelines (docs/Guidelines.md)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zerotosaas.resetRestTimer",
          "when": "true"
        },
        {
          "command": "zerotosaas.openSettings",
          "when": "true"
        },
        {
          "command": "zerotosaas.openGuidelines",
          "when": "true"
        }
      ]
    },
    "configurationDefaults": {
      "[markdown]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
          "comments": "off",
          "strings": "off",
          "other": "off"
        },
        "editor.renderWhitespace": "selection"
      },
      "[plaintext]": {
        "editor.wordWrap": "on"
      },
      "[typescript]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[typescriptreact]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[javascript]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[javascriptreact]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[python]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[rust]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[go]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[kotlin]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[swift]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[dart]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      },
      "[sql]": {
        "editor.suggest.insertMode": "replace"
      },
      "[json]": {
        "editor.quickSuggestions": {
          "strings": true
        }
      },
      "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      }
    }
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "node scripts/generate-themes.js && node scripts/update-ide-configs.js && node scripts/generate-gallery.js && node scripts/export-tokens.js",
    "update-ide-configs": "node scripts/update-ide-configs.js",
    "validate": "node scripts/validate-contrast.js",
    "gallery": "node scripts/generate-gallery.js",
    "tokens": "node scripts/export-tokens.js",
    "package": "vsce package --no-git-tag-version",
    "publish:ovsx": "ovsx publish",
    "publish:vsce": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^0.10.2"
  }
}
