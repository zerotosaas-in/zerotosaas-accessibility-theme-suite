      },
      {
        "label": "ZeroToSaaS Deuteranopia (Blue / Orange)",
        "uiTheme": "vs",
        "path": "./themes/zerotosaas-deuteranopia.json"
      },
      {
        "label": "ZeroToSaaS Protanopia (Magenta / Teal)",
        "uiTheme": "vs",
        "path": "./themes/zerotosaas-protanopia.json"
      },
      {
        "label": "ZeroToSaaS Tritanopia (Crimson / Cyan)",
        "uiTheme": "vs",
        "path": "./themes/zerotosaas-tritanopia.json"
      },
      {
        "label": "ZeroToSaaS Warm Sepia (Brown)",
        "uiTheme": "vs",
        "path": "./themes/zerotosaas-brown.json"
      },
      {
        "label": "ZeroToSaaS Forest Calm (Green)",
        "uiTheme": "vs",
        "path": "./themes/zerotosaas-green.json"
      },
      {
        "label": "ZeroToSaaS Royal Plum (Purple)",
        "uiTheme": "vs",
        "path": "./themes/zerotosaas-purple.json"
      },
      {
        "label": "ZeroToSaaS Golden Sand (Yellow)",
        "uiTheme": "vs",
        "path": "./themes/zerotosaas-yellow.json"
      },
      {
        "label": "ZeroToSaaS Terracotta (Orange)",
        "uiTheme": "vs",
        "path": "./themes/zerotosaas-orange.json"
      },
      {
        "label": "ZeroToSaaS Light Night (Default)",
        "uiTheme": "vs-dark",
        "path": "./themes/zerotosaas-light-night.json"
      },
      {
        "label": "ZeroToSaaS High Contrast Night (ISO 9241-303)",
        "uiTheme": "hc-black",
        "path": "./themes/zerotosaas-high-contrast-night.json"
      },
      {
        "label": "ZeroToSaaS Deuteranopia Night (Blue / Orange)",
        "uiTheme": "vs-dark",
        "path": "./themes/zerotosaas-deuteranopia-night.json"
      },
      {
        "label": "ZeroToSaaS Protanopia Night (Magenta / Teal)",
        "uiTheme": "vs-dark",
        "path": "./themes/zerotosaas-protanopia-night.json"
      },
      {
        "label": "ZeroToSaaS Tritanopia Night (Crimson / Cyan)",
        "uiTheme": "vs-dark",
        "path": "./themes/zerotosaas-tritanopia-night.json"
      },
      {
        "label": "ZeroToSaaS Warm Sepia Night (Brown)",
        "uiTheme": "vs-dark",
        "path": "./themes/zerotosaas-brown-night.json"
      },
      {
        "label": "ZeroToSaaS Forest Calm Night (Green)",
        "uiTheme": "vs-dark",
        "path": "./themes/zerotosaas-green-night.json"
      },
      {
        "label": "ZeroToSaaS Royal Plum Night (Purple)",
        "uiTheme": "vs-dark",
