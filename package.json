  "version": "0.3.0",
  "publisher": "zerotosaas-in",
  "author": {
    "name": "Sarvasv Technologies Pvt Ltd (ZeroToSaaS.in)",
    "url": "https://zerotosaas.in"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zerotosaas/vsx-theme-zerotosaas.git"
  },
  "homepage": "https://github.com/zerotosaas/vsx-theme-zerotosaas#readme",
  "bugs": {
    "url": "https://github.com/zerotosaas/vsx-theme-zerotosaas/issues"
  },
  "license": "AGPL-3.0",
  "keywords": [
    "zerotosaas",
    "light theme",
    "accessibility",
    "wcag-aaa",
    "colorblind",
    "deuteranopia",
    "protanopia",
    "tritanopia",
    "high contrast",
    "iso-9241-303",
    "eye health",
    "medical optics",
    "code smell",
    "security",
    "antigravity",
    "windsurf",
    "cascade",
    "ai-theme"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes",
    "Programming Languages",
    "Other"
  ],
  "galleryBanner": {
    "color": "#FAFAFC",
    "theme": "light"
  },
  "contributes": {
